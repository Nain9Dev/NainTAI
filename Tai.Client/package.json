    "idb": "^8.0.4",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@tanstack/router-cli": "^1.167.46",
    "@tanstack/router-plugin": "^1.168.48",
    "@types/node": "^24.13.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "orval": "^8.44.0",
    "oxlint": "^1.89.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.5",
    "vitest": "^3.2.7"
