# Same hostname as the dev server on purpose. tai.localhost:5290 (client) and
# tai.localhost:5298 (API) differ only by port, so the browser treats them as the same
# site and sends the SameSite=Lax session cookies. Pointing the client at
# localhost:5298 while it runs on tai.localhost would be cross-site, and login would
# fail locally for reasons that have nothing to do with the code.
VITE_API_BASE_URL=http://tai.localhost:5298/api
